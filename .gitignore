# secrets
.env
.env.*

node_modules/

# media and caches are regenerated by the pipeline (and paid media is cached locally, not shipped)
projects/*/build/cache/
projects/*/build/mock/
projects/*/build/assets/
projects/*/build/render/
projects/*/build/mix/
projects/*/build/review/
projects/*/build/final/*.mp4
projects/*/build/final/*.m4a
projects/*/build/*.before-cut.json

# OSM-derived databases (ODbL) and Wikipedia-derived evidence (CC BY-SA) are rebuilt by `geo` and
# `ground` from their sources instead of being redistributed here
projects/*/build/geo.json
projects/*/build/geo_detail.json
projects/*/build/ground.json

# local test project
projects/_fixture/

# never ship rendered films or backups
*.mp4
projects/*/build/backup*/
projects/*/build/*.before-*.json
